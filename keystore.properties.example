# 复制为 keystore.properties 后即可使用自有证书。
#
# ⚠️ 本文件**不入库**（已在 .gitignore 中）。本仓库构建时默认使用
#    内置的 keystore/release.jks —— 本项目完全开源，自签密钥公开
#    不会带来额外风险，反而能保证「本地包」与「CI 包」签名一致、
#    可以互相覆盖安装（这是在线更新的前提）。
#    详见 README「签名」一节。
#
# 什么时候才需要填这个文件：
#   - 想用自己的证书发布；
#   - 或CI 里用 CNB 密钥库注入了私有密钥，本地想保持一致。
#
# ⚠️ KEYSTORE_FILE 指向的文件必须**真实存在**，否则构建**不会**回退到
#    内置密钥，而是直接在 validateSigningRelease 阶段报
#    「Keystore file ... not found」。改密钥文件名后记得同步改这里。
KEYSTORE_FILE=keystore/release.jks
KEYSTORE_PASSWORD=btwaf2026
KEY_ALIAS=btwaf
KEY_PASSWORD=btwaf2026
